        <mxCell id="arrPL1L2lbl" connectable="0" parent="arrPL1L2" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fillColor=#ffffff;" value="query_rule&#xa;=&gt; SQL view&#xa;over L2 records" vertex="1">
          <mxGeometry relative="1" as="geometry" />
