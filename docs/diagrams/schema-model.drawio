        <mxCell id="recRoot" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3367d6;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="GeoJSON Feature&#xa;&#xa;id              ARC slug&#xa;type            &#39;Feature&#39;&#xa;conformsTo      [ &#39;…/ogcapi-records-1/core&#39; ]&#xa;time            { interval: [start, end] | null }&#xa;geometry        GeoJSON or null&#xa;properties      ↓&#xa;links[]         self · canonical · cite-as · via" vertex="1">
          <mxGeometry height="190" width="460" x="560" y="190" as="geometry" />
        </mxCell>
        <mxCell id="recProps" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3367d6;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="properties (top-level)&#xa;&#xa;title · description · created · updated · keywords[]&#xa;language · license · doi · arc_source_uri&#xa;contacts[] · creators[] · publications[]&#xa;omics_domains[]      ← L3 promoted&#xa;experiment_context   ← L3 promoted&#xa;organism[]           ← L3 promoted&#xa;project[]            ← L3 promoted&#xa;studies[]            { id, title, design_type, factors[] }&#xa;assays[]             { id, domain, technology_type,&#xa;                       measurement_type, file_counts,&#xa;                       …per-domain extension }&#xa;record_quality   complete | partial&#xa;harvested_at · harvester_version" vertex="1">
          <mxGeometry height="280" width="460" x="560" y="390" as="geometry" />
