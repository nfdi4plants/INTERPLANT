        <mxCell id="l3schema" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#666666;fillColor=none;strokeColor=none;" value="schemas/vocabularies.yaml (registry)" vertex="1">
          <mxGeometry height="20" width="360" x="1100" y="158" as="geometry" />
        </mxCell>
        <mxCell id="l3shared" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="Shared (top-level)&#xa;&#xa;omics_domains       array&lt;enum&gt;&#xa;experiment_context  enum&#xa;organism            array&lt;string&gt;&#xa;project             array&lt;string&gt;&#xa;keywords            array&lt;string&gt;&#xa;time_interval       datetime range&#xa;bbox                geometry&#xa;doi                 string (exact)&#xa;record_quality      enum" vertex="1">
          <mxGeometry height="225" width="320" x="1120" y="190" as="geometry" />
        </mxCell>
