        <mxCell id="l2schema" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#666666;fillColor=none;strokeColor=none;" value="schemas/record.schema.json  +  assay-extensions.schema.json" vertex="1">
