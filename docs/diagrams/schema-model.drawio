        <mxCell id="l1fields" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;spacingTop=8;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;id&lt;/span&gt;&lt;/div&gt;title&lt;br&gt;description / narrative (Markdown)&lt;br&gt;keywords[]&lt;br&gt;license&lt;br&gt;provider { name, url }&lt;br&gt;extent { spatial.bbox, temporal.interval }&lt;br&gt;links[] (describedby, items, related)&lt;br&gt;featured: [arc_id, …]&lt;br&gt;query_rule -&amp;gt; SQL expression&lt;br&gt;defining the membership view" vertex="1">
