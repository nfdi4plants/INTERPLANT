        </mxCell>
        <mxCell id="src" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" value="DataPLANT Data Hubs&lt;br&gt;(GitLab / nfdi4plants)&lt;br&gt;&lt;br&gt;Storage of ARCs&lt;br&gt;ISA investigation/study/assay (XLSX)" vertex="1">
