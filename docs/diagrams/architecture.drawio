        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;fillColor=none;strokeColor=none;" value="Read-only flow from DataPLANT Data Hubs into the Earth Data Portal via a rebuildable Postgres catalog." vertex="1">
