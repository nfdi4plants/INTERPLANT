        <mxCell id="harv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" value="Harvester (Python, nightly GitLab CI)&#xa;&#xa;1. Enumerate public ARCs (GitLab REST)&#xa;2. Quality filter + dedup (~150 ARCs)&#xa;3. Parse ISA via arctrl&#xa;4. Classify omics &amp; experiment context&#xa;5. Build L2 record (one per ARC)&#xa;6. Idempotent UPSERT" vertex="1">
          <mxGeometry height="200" width="290" x="340" y="340" as="geometry" />
        </mxCell>
        <mxCell id="pg" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;" value="Postgres + PostGIS (catalog store)&lt;br&gt;&lt;br&gt;arc_records  (one row per ARC, JSONB body)&lt;br&gt;collections  (L1 descriptors loaded from YAML)&lt;br&gt;11 SQL views (one per collection - membership rule)&lt;br&gt;&lt;br&gt;Single source of truth - rebuildable from scratch" vertex="1">
          <mxGeometry height="240" width="320" x="690" y="320" as="geometry" />
        </mxCell>
