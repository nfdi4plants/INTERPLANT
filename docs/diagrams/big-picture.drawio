        <mxCell id="harv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" value="Harvester&lt;br&gt;&lt;i&gt;nightly GitLab CI&lt;/i&gt;&lt;br&gt;&lt;br&gt;- enumerate ARCs&lt;br&gt;- filter + dedup&lt;br&gt;- parse ISA&lt;br&gt;- classify (omics + context)&lt;br&gt;- build L2 record&lt;br&gt;- idempotent UPSERT" vertex="1">
