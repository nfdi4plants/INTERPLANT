        <mxCell id="e6lbl" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;fillColor=#ffffff;strokeColor=none;fontColor=#666666;" value="live queries from&#xa;portal plugin (WP2)" vertex="1">
          <mxGeometry height="30" width="130" x="1050" y="440" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="user" style="endArrow=block;startArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" target="portal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="extClients" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=center;dashed=1;fontStyle=2;fontColor=#555555;" value="Other standards-based clients&#xa;(QGIS, STAC tooling, ...)&#xa;Future, no bespoke code" vertex="1">
          <mxGeometry height="60" width="220" x="830" y="570" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="pyg" style="endArrow=block;html=1;rounded=0;strokeWidth=1;strokeColor=#999999;dashed=1;" target="extClients">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="reg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b8860b;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="One-time handshake (P0, M1)&#xa;&#xa;1. Email o2a-support@awi.de&#xa;2. Get sandbox at rz-000566.cloud.awi.de/harvester/&#xa;3. Validate records against DocumentSchema.json&#xa;4. Switch portal harvester to production endpoint" vertex="1">
          <mxGeometry height="120" width="380" x="1020" y="80" as="geometry" />
        </mxCell>
        <mxCell id="wp1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;WP1 - Metadata interface (M4)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;What:&lt;/b&gt; every quality-filtered ARC becomes searchable on earth-data.de.&lt;br&gt;&lt;br&gt;&lt;b&gt;Mechanism:&lt;/b&gt; the OAI-PMH endpoint serves DocumentSchema.json records;&lt;br&gt;the portal harvester pulls nightly and indexes them into the portal&#39;s search backend.&lt;br&gt;&lt;br&gt;&lt;b&gt;User-visible outcome:&lt;/b&gt; a search for &quot;Arabidopsis transcriptomics&quot; returns&lt;br&gt;DataPLANT ARCs alongside marine and atmospheric datasets. Each result shows&lt;br&gt;title, abstract, ORCID-resolved authors, ROR-resolved institutions, DOI, geometry,&lt;br&gt;and a link back to the canonical ARC on git.nfdi4plants.org.&lt;br&gt;&lt;br&gt;&lt;b&gt;Standards exposed:&lt;/b&gt; OAI-PMH (today) + OGC API Records 1.0 + CQL2 (future-facing)." vertex="1">
          <mxGeometry height="320" width="750" x="60" y="740" as="geometry" />
        </mxCell>
        <mxCell id="wp2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;WP2 - Earth Data Portal collections (M5)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;What:&lt;/b&gt; 11 themed landing pages inside the portal (8 omics + 3 contexts).&lt;br&gt;&lt;br&gt;&lt;b&gt;Mechanism:&lt;/b&gt; a portal plugin renders one template per collection. Static parts&lt;br&gt;(title, narrative, featured ARCs) come from hand-curated L1 YAML in git;&lt;br&gt;live parts (record counts, map of locations, browse table) come from pygeoapi&lt;br&gt;queries against the same Postgres.&lt;br&gt;&lt;br&gt;&lt;b&gt;User-visible outcome:&lt;/b&gt; a &quot;DataPLANT - Transcriptomics&quot; page with&lt;br&gt;hero+stats strip, narrative by IBG-4, featured ARCs, location map,&lt;br&gt;and a faceted browse table backed by live L3 queryables.&lt;br&gt;&lt;br&gt;&lt;b&gt;Authoring:&lt;/b&gt; narrative + featured ARCs PR-reviewed in git (no CMS)." vertex="1">
          <mxGeometry height="320" width="750" x="850" y="740" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;" value="&lt;b&gt;Reading guide&lt;/b&gt;&lt;br&gt;- Solid arrow = required path to ship&lt;br&gt;- Dashed arrow = future / opportunistic consumer&lt;br&gt;- Lanes (gray dashed) = ownership boundary&lt;br&gt;- Cylinder = persistent store / data source&lt;br&gt;- Rounded box = service / process" vertex="1">
          <mxGeometry height="110" width="340" x="40" y="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
