        <mxCell id="e5lbl" parent="1" style="text;html=1;align=center;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;fontColor=#9673a6;" value="nightly pull&#xa;(OAI-PMH)" vertex="1">
          <mxGeometry height="32" width="90" x="1055" y="290" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="pyg" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#9673a6;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" target="portal">
