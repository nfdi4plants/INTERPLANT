{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interplant.org/schemas/record.schema.json",
  "title": "INTERPLANT L2 record (one ARC)",
  "type": "object",
  "required": ["id", "type", "properties", "links"],
  "additionalProperties": false,
  "properties": {
    "id":         { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type":       { "const": "Feature" },
    "conformsTo": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "time": {
      "type": "object",
      "required": ["interval"],
      "properties": {
        "interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": ["string", "null"] }
        }
      }
    },
    "geometry":   { "type": ["object", "null"] },
    "properties": { "$ref": "#/$defs/Properties" },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/Link" }
    }
  },
  "$defs": {
    "Link": {
      "type": "object",
      "required": ["rel", "href"],
      "properties": {
        "rel":   { "type": "string" },
        "href":  { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "type":  { "type": "string" }
      }
    },
    "Properties": {
      "type": "object",
      "required": [
        "title", "description", "created", "updated",
        "keywords", "license",
        "arc_source_uri", "uniqueId",
        "record_quality", "harvested_at", "harvester_version"
      ],
      "additionalProperties": true,
      "properties": {
        "title":          { "type": "string", "minLength": 1 },
        "description":    { "type": "string" },
        "created":        { "type": "string", "format": "date-time" },
        "updated":        { "type": "string", "format": "date-time" },
        "keywords":       { "type": "array", "items": { "type": "string" } },
        "language":       { "type": "string", "minLength": 2 },
        "license":        { "type": "string" },
        "doi":            { "type": "string", "pattern": "^10\\." },
        "arc_source_uri": { "type": "string", "format": "uri" },
        "uniqueId":       { "type": "string", "format": "uuid" },
        "record_quality":    { "enum": ["complete", "partial"] },
        "harvested_at":      { "type": "string", "format": "date-time" },
        "harvester_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" }
      }
    }
  }
}
