[Unit]
Description=INTERPLANT nightly refresh (harvest only when the enumeration changed)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=interplant
Group=interplant
WorkingDirectory=/opt/interplant
EnvironmentFile=/etc/interplant/env
# Most nights this exits in minutes after the enumeration diff comes back
# empty. When it does harvest, expect 30-60 minutes: ~227 ARCs at roughly 16s
# each, with the four mega-ARCs excluded before the clone.
#
# The 900s per-ARC parse cap below is a net, not a routine mechanism. The four
# known mega-ARCs are excluded by path in harvester/exclusions.py, so it should
# never fire; it is there for an unknown fifth, which is exactly what wedged
# seven consecutive nights in September 2026. Set high on purpose: the typical
# ARC is ~16s, and a 300s cap cleanly separated the four megas from all 205
# other ARCs in the 2026-07-29 run, so 900s cannot plausibly drop a
# slow-but-valid ARC. A cap that fired routinely would be indistinguishable
# from real breakage in the audit report.
#
# --clone-timeout 180 rather than the 60s default: the 2026-07-29 run lost 4
# ARCs to a 60s ceiling and 180s recovered 2 of them (harvester/batch.py). A
# clone failure does not fail the run, so a lost ARC is a silently missing
# record that the cardinality gate cannot see.
ExecStart=/opt/interplant/.venv/bin/python -m harvester refresh \
    --out-dir /var/lib/interplant/harvest-runs \
    --max-age-days 7 \
    --parse-timeout 900 \
    --clone-timeout 180
# 4h is the outer bound, and it is the anti-wedge backstop: systemd will not
# start a second instance of a oneshot while one is active, so a run that
# wedges would block every subsequent night. Do not raise or remove it without
# replacing that protection. Being killed at the bound is harmless by design:
# staging is scratch and public.records is untouched until the swap, so a
# SIGTERM here costs tonight's harvest and nothing else.
#
# 4h is PROVISIONAL and deliberately loose. The 30-60 minute estimate above
# comes from ARCs 1-87 of one run; ARCs 88-231 have never been harvested to
# completion on this box, at Nice=10 while gunicorn serves the endpoint.
# Tighten this once a real run has been timed, not before.
TimeoutStartSec=4h
# The box has 4 vCPU and also serves the endpoint. Yield to it.
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/interplant

# No [Install] section: this is a oneshot activated only by
# interplant-refresh.timer. `systemctl enable` on THIS unit (a plausible typo
# for the timer) would schedule a full unattended harvest at every boot;
# without an [Install] section there is nothing for enable to hook.
