[Unit]
Description=INTERPLANT nightly refresh (harvest only when the enumeration changed)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=interplant
Group=interplant
WorkingDirectory=/opt/interplant
EnvironmentFile=/etc/interplant/env
# Most nights this exits in minutes after the enumeration diff comes back empty.
# When it does harvest, expect 2.5-4 hours single-threaded, so no per-ARC
# timeout here.
ExecStart=/opt/interplant/.venv/bin/python -m harvester refresh \
    --out-dir /var/lib/interplant/harvest-runs \
    --max-age-days 7
# refresh passes no --parse-timeout, so arctrl's parse of a single ARC is
# unbounded (harvester/timeouts.py: a slow-but-valid ARC is legitimate data,
# not something to drop). A oneshot with no outer bound that wedges would
# block every subsequent night, since systemd will not start a second
# instance while one is active. 6h is an outer bound against the documented
# 2.5-4h harvest above, not a per-ARC cap. Being killed mid-harvest is
# harmless by design: staging is scratch and public.records is untouched
# until the swap.
TimeoutStartSec=6h
# The box has 4 vCPU and also serves the endpoint. Yield to it.
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/interplant

[Install]
WantedBy=multi-user.target
