# Copy to /etc/interplant/env, chmod 0600, chown root:root, then fill in.
# All three variables are required. They are read by different components:
#   INTERPLANT_DSN         - the OAI endpoint (interplant-oai.service)
#   INTERPLANT_PG_DSN      - the harvester's refresh command (interplant-refresh.service)
#   INTERPLANT_OAI_BASE_URL - the URL advertised in <baseURL>, read by the endpoint
# The two DSN lines are NOT interchangeable, but both fail closed the same
# way: the endpoint refuses to start without INTERPLANT_DSN, and `refresh`
# refuses to run without INTERPLANT_PG_DSN. Neither component falls back to
# a default database, so a dropped line here stops the affected component
# loudly instead of writing to a stray one.

INTERPLANT_DSN=postgresql://interplant:CHANGE-ME@localhost:5432/interplant
INTERPLANT_PG_DSN=postgresql://interplant:CHANGE-ME@localhost:5432/interplant

# The URL AWI has registered. Advertised verbatim in <baseURL>, so it must be
# the URL that actually answers, not the internal address.
INTERPLANT_OAI_BASE_URL=https://www.plabipd.de/oai
