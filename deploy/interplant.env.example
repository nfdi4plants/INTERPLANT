# Copy to /etc/interplant/env, chmod 0600, chown root:root, then fill in.
# All variables are required for a working install: they are read by different
# components, and a dropped line degrades or breaks the affected component
# instead of being noticed:
#   INTERPLANT_DSN          - the OAI endpoint (interplant-oai.service)
#   INTERPLANT_PG_DSN       - the harvester's refresh command (interplant-refresh.service)
#   INTERPLANT_OAI_BASE_URL - the URL advertised in <baseURL>, read by the endpoint
# The pygeoapi block below runs in the pinned container
# (interplant-pygeoapi.service). Its placeholders carry dev defaults, but the
# dev defaults are wrong on the VM: the bind would be 0.0.0.0:80 and the
# database host 'db' only exists on the docker network. Set every one of them.
# The two DSN lines are NOT interchangeable, but both fail closed the same
# way: the endpoint refuses to start without INTERPLANT_DSN, and `refresh`
# refuses to run without INTERPLANT_PG_DSN. Neither component falls back to
# a default database, so a dropped line here stops the affected component
# loudly instead of writing to a stray one.

INTERPLANT_DSN=postgresql://interplant:CHANGE-ME@localhost:5432/interplant
INTERPLANT_PG_DSN=postgresql://interplant:CHANGE-ME@localhost:5432/interplant

# The URL AWI has registered. Advertised verbatim in <baseURL>, so it must be
# the URL that actually answers, not the internal address.
INTERPLANT_OAI_BASE_URL=https://www.plabipd.de/oai

# pygeoapi (interplant-pygeoapi.service). The unit forwards only the variables
# below into the container (docker run -e), deliberately leaving the owner
# DSNs (INTERPLANT_DSN, INTERPLANT_PG_DSN) out of the public container.
# INTERPLANT_PG_RO_PASSWORD is also read by install.sh when it creates the
# read-only role, so the two cannot drift apart.
INTERPLANT_PG_HOST=localhost
INTERPLANT_PG_PORT=5432
INTERPLANT_PG_DBNAME=interplant
INTERPLANT_PG_USER=pygeoapi_ro
INTERPLANT_PG_PASSWORD=CHANGE-ME
INTERPLANT_PG_RO_PASSWORD=CHANGE-ME

# gunicorn in the pygeoapi image binds from CONTAINER_HOST/CONTAINER_PORT
# (/entrypoint.sh). Bind the internal interface, not loopback: Marie's TLS
# proxy is on another host and ufw admits only it. Must match what the
# proxy forwards to. (The server.bind placeholders in pygeoapi-config.yml
# are read only by pygeoapi's standalone dev server, not by this
# container, so CONTAINER_HOST/CONTAINER_PORT are the operative pair.)
CONTAINER_HOST=192.0.2.10
CONTAINER_PORT=8001

# gunicorn prepends SCRIPT_NAME to every route and link, mounting the API
# under the public path. The proxy at plabipd.de must pass this prefix
# through unchanged (as it does for /oai). Empty means the app serves at '/'.
SCRIPT_NAME=/ogc

# Baked into every link pygeoapi emits, so it must be the URL that actually
# answers from outside, not the internal address. Confirm the path with Marie.
INTERPLANT_OGC_BASE_URL=https://www.plabipd.de/ogc
