# Copy to /etc/interplant/env, chmod 0600, chown root:root, then fill in.
# Both variables are required. The service refuses to start without the DSN
# rather than falling back to default credentials.

INTERPLANT_DSN=postgresql://interplant:CHANGE-ME@localhost:5432/interplant
INTERPLANT_PG_DSN=postgresql://interplant:CHANGE-ME@localhost:5432/interplant

# The URL AWI has registered. Advertised verbatim in <baseURL>, so it must be
# the URL that actually answers, not the internal address.
INTERPLANT_OAI_BASE_URL=https://www.plabipd.de/oai
