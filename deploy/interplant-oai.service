[Unit]
Description=INTERPLANT OAI-PMH endpoint
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=interplant
Group=interplant
WorkingDirectory=/opt/interplant
EnvironmentFile=/etc/interplant/env
# INTERPLANT_OAI_BIND (host:port) comes from the EnvironmentFile. It is the
# internal interface, not loopback, because the TLS proxy runs on another host,
# and not all interfaces, because ufw admits only the proxy.
ExecStart=/opt/interplant/.venv/bin/gunicorn \
    --bind ${INTERPLANT_OAI_BIND} \
    --workers 2 \
    --access-logfile - \
    oai.app:app
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/interplant

[Install]
WantedBy=multi-user.target
